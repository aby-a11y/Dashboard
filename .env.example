# Copy to .env and fill in real values. Never commit the real .env.

# Postgres. Omit to fall back to a local sqlite file (dashboard.db) for dev.
DATABASE_URL=postgresql+psycopg2://seo_user:changeme@localhost:5432/seo_dashboard

# Redis cache (GSC query cache + Serper rank cache). Dashboard still works
# without it, just slower — every query hits the live API instead of cache.
REDIS_URL=redis://localhost:6379/0

# Existing app secrets (unchanged):
SERPER_API_KEY=
JWT_SECRET=
